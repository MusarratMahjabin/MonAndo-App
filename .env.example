# Copy this file to ".env" (same folder) and fill in real values from your
# Firebase project settings (Project settings → General → Your apps → SDK
# setup and configuration). ".env" itself is not committed to GitHub — only
# this template is.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-side only (no "VITE_" prefix — see api/gemini.js and
# api/elevenlabs.js, the only files allowed to read these).
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
